<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="account_invoices_thermal" model="ir.actions.report">
            <field name="name">Invoices thermal</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">his.invoice_receipt_report_thermal</field>
            <field name="report_file">his.invoice_receipt_report_thermal</field>
            <field name="print_report_name">(object._get_report_base_filename())</field>
            <field name="attachment">(object.state == 'posted') and ((object.name or
                'INV').replace('/','_')+'.pdf')</field>
            <field name="binding_model_id" ref="model_account_move" />
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="his.thermal_qweb_paperformat"/>
        </record>
    </data>
</odoo>