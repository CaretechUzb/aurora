<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="his.payment_history_lines">
        <table class="table table-condensed table-statement">
            <thead>
                <tr>
                    <tr>
                        <th t-att-style="'background-color: #f5f5f5; color: #333; font-weight: bold; text-align: left;'">
                            Date</th>
                        <th t-att-style="'background-color: #f5f5f5; color: #333; font-weight: bold; text-align: left;'">
                            Date Time</th>
                        <th t-att-style="'background-color: #f5f5f5; color: #333; font-weight: bold; text-align: left;'">
                            Create User</th>
                        <th t-att-style="'background-color: #f5f5f5; color: #333; font-weight: bold; text-align: left;'">
                            Operation</th>
                        <th class="amount"
                            t-att-style="'background-color: #f5f5f5; color: #333; font-weight: bold; text-align: right;'">
                            Amount</th>
                        <th class="amount"
                            t-att-style="'background-color: #f5f5f5; color: #333; font-weight: bold; text-align: right;'">
                            Journal Name</th>
                        <!-- <th class="amount"
                            t-att-style="'background-color: #f5f5f5; color: #333; font-weight: bold; text-align: right;'">
                            Payment Method Name</th> -->
                    </tr>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="currency['lines']" t-as="line">
                    <td>
                        <span t-out="line['date']"/>
                    </td>
                    <td>
                        <span t-out="line['create_date']"/>
                    </td>
                    <td>
                        <span t-out="line['create_user']"/>
                    </td>
                    <td>
                        <span t-out="line['case_ref']"/>
                    </td>
                    <td class="amount">
                        <span t-att-class="line['display_amount'] &lt; 0 and 'negative' or ''">
                            <span t-out="line['display_amount']" style="text-align: right;"
                                  t-options="{'widget': 'monetary', 'display_currency': display_currency}"/>
                        </span>
                    </td>
                    <td>
                        <span t-out="line['journal_name']"/>
                    </td>
                </tr>
            </tbody>
        </table>
    </template>
    <template id="his.payment_history_document">
        <t>
            <t t-set="o" t-value="o.with_context({'lang': lang})"/>
            <div class="page">
                <t t-if="d['currencies']">
                    <t t-foreach="d['currencies'].items()" t-as="currency">
                        <t t-set="display_currency" t-value="Currencies[currency[0]]"/>
                        <t t-set="currency" t-value="currency[1]"/>
                        <t
                                t-call="his.payment_history_lines"
                                name="activity"
                        />
                    </t>
                </t>
            </div>
        </t>
    </template>
    <template id="his.payment_history">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="d" t-value="data.get(o.id)"/>
                <t
                        t-call="his.payment_history_document"
                        t-lang="lang"
                />
            </t>
        </t>
    </template>
    <record id="action_print_activity_statement" model="ir.actions.report">
        <field name="name">Partner payment history</field>
        <field name="model">res.partner</field>
        <field name="report_name">his.payment_history</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_file">his.payment_history</field>
    </record>
    <record id="action_print_partner_payment_history_html" model="ir.actions.report">
        <field name="name">Partner payment history</field>
        <field name="model">res.partner</field>
        <field name="report_name">his.payment_history</field>
        <field name="report_type">qweb-html</field>
        <field name="report_file">his.payment_history</field>
    </record>


    <template id="report_patient_invoice_data">
        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="patient">
                <div class="page">
                    <table class="patient-invoice-table" style="table-layout: auto;overflow: auto;">
                        <thead>
                            <tr>
                                <th style="min-width: 100px;white-space: nowrap;" class="col-order-number">Order Number</th>
                                <th style="min-width: 120px;white-space: nowrap;" class="col-order-date">Order Date</th>
                                <th style="min-width: 120px;white-space: nowrap;" class="col-amount-total">Amount Total</th>
                                <th style="min-width: 100px;white-space: nowrap;" class="col-payers">Discount</th>
                                <th style="min-width: 120px;white-space: nowrap;" class="col-commitment-date">Commitment Date</th>
                                <th style="min-width: 120px;white-space: nowrap;" class="col-expected-date">Expected Date</th>
                                <th style="min-width: 120px;white-space: nowrap;" class="col-salesperson">Salesperson</th>
                                <th style="min-width: 100px;white-space: nowrap;" class="col-sales-team">Sales Team</th>
                                <th style="min-width: 100px;white-space: nowrap;" class="col-company">Company</th>
                                <!-- <th style="min-width: 140px;white-space: nowrap;" class="col-amount-untaxed">Amount Untaxed</th> -->
                                <th style="min-width: 100px;white-space: nowrap;" class="col-tax">Tax</th>
                                <th style="min-width: 100px;white-space: nowrap;" class="col-currency">Currency</th>
                                <th style="min-width: 100px;white-space: nowrap;" class="col-invoice-status">Invoice Status</th>
                                <th style="min-width: 100px;white-space: nowrap;" class="col-payment-status">Payment Status</th>
                                <th style="min-width: 120px;white-space: nowrap;" class="col-payers">Payers</th>
                                <th style="min-width: 120px;white-space: nowrap;" class="col-payers">Create User</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="data" t-as="order">
                                <tr>
                                    <td style="text-align:center;">
                                        <t t-if="order['link']">
                                            <a t-att-href="order['link']" target="_blank">
                                                <t t-esc="order['name']"/>
                                            </a>
                                        </t>
                                        <t t-else="">
                                            <t t-esc="order['name']"/>
                                        </t>
                                    </td>
                                    <td style="text-align:center;"><t t-esc="order['date_order']"/></td>
                                    <td style="text-align:end;"><t t-esc="order['amount_total']"/></td>
                                    <td style="text-align:end;"><t t-esc="order['discount']"/></td>
                                    <td style="text-align:center;"><t t-esc="order['commitment_date'] or ''"/></td>
                                    <td style="text-align:center;"><t t-esc="order['expected_date'] or ''"/></td>
                                    <td style="text-align:center;">
                                        <t t-set="salesperson" t-value="env['res.users'].browse(order['user_id'])"/>
                                        <t t-esc="salesperson.name if salesperson else ''"/>
                                    </td>
                                    <td style="text-align:center;">
                                        <t t-set="team" t-value="env['crm.team'].browse(order['team_id'])"/>
                                        <t t-esc="team.name if team else ''"/>
                                    </td>
                                    <td style="text-align:center;">
                                        <t t-set="company" t-value="env['res.company'].browse(order['company_id'])"/>
                                        <t t-esc="company.name if company else ''"/>
                                    </td>
                                    <!-- <td style="text-align:end;"><t t-esc="order['amount_untaxed']"/></td> -->
                                    <td style="text-align:end;"><t t-esc="order['amount_tax']"/></td>
                                    <td style="text-align:center;">
                                        <t t-set="currency" t-value="env['res.currency'].browse(order['currency_id'])"/>
                                        <t t-esc="currency.name if currency else ''"/>
                                    </td>
                                    <td style="text-align:center;"><t t-esc="order['invoice_status']"/></td>
                                    <td style="text-align:center;"><t t-esc="order['payment_status']"/></td>
                                    <td style="text-align:center;"><t t-esc="order['partner_ids_char'] or ''" class="small-text"/></td>
                                    <td style="text-align:center;"><t t-esc="order['create_uid'] or ''" class="small-text"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <record id="action_print_patient_data_html" model="ir.actions.report">
        <field name="name">Patient Invoice Data</field>
        <field name="model">his.patient</field>
        <field name="report_name">his.report_patient_invoice_data</field>
        <field name="report_type">qweb-html</field>
        <field name="report_file">his.report_patient_invoice_data</field>
    </record>

</odoo>
