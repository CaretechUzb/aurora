<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_send_message_form" model="ir.ui.view">
        <field name="name">his.send_message.form</field>
        <field name="model">his.send_message</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="patient_id" invisible="1"/>
                        <field name="message"/>
                        <field name="type" widget="radio"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_send_message_readonly_form" model="ir.ui.view">
        <field name="name">his.send_message.form</field>
        <field name="model">his.send_message</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="patient_id" invisible="1"/>
                        <field name="message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_send_message_tree" model="ir.ui.view">
        <field name="name">his.send_message.tree</field>
        <field name="model">his.send_message</field>
        <field name="arch" type="xml">
            <tree>
                <field name="patient_id" readonly="1"/>
                <field name="message"/>
            </tree>
        </field>
    </record>

    <record id="view_send_message_search" model="ir.ui.view">
        <field name="name">his.send_message.search</field>
        <field name="model">his.send_message</field>
        <field name="arch" type="xml">
            <search>
                <field name="patient_id" invisible="1"/>
            </search>
        </field>
    </record>


    <record id="action_send_message" model="ir.actions.act_window">
        <field name="name">Send Message</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">his.send_message</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_child': 1}</field>
        <field name="search_view_id" ref="his.view_send_message_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_send_message_readonly_form')})]"/>

    </record>

