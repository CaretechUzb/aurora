<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_cancel_cause_form" model="ir.ui.view">
        <field name="name">his.cancel_cause.form</field>
        <field name="model">his.cancel_cause</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="title"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cancel_cause_tree" model="ir.ui.view">
        <field name="name">his.cancel_cause.tree</field>
        <field name="model">his.cancel_cause</field>
        <field name="arch" type="xml">
            <tree>
                <field name="title"/>
            </tree>
        </field>
    </record>

    <record id="view_cancel_cause_search" model="ir.ui.view">
        <field name="name">his.cancel_cause.search</field>
        <field name="model">his.cancel_cause</field>
        <field name="arch" type="xml">
            <search>
                <field name="title"/>
            </search>
        </field>
    </record>


    <record id="action_cancel_cause" model="ir.actions.act_window">
        <field name="name">Cancel Cause</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">his.cancel_cause</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_child': 1}</field>
        <field name="search_view_id" ref="his.view_cancel_cause_search"/>
    </record>

    <menuitem id="menu_cancel_cause"
              name="Cancel Cause"
              parent="his.menu_other_configurations"
              action="action_cancel_cause"
              sequence="9"/>
</odoo>