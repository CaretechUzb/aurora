<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_prescription_instruction_form" model="ir.ui.view">
        <field name="name">his.prescription_instruction.form</field>
        <field name="model">his.prescription_instruction</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="instruction"/>
                        <field name="code"/>
                        <field name="times"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_prescription_instruction_tree" model="ir.ui.view">
        <field name="name">his.prescription_instruction.tree</field>
        <field name="model">his.prescription_instruction</field>
        <field name="arch" type="xml">
            <tree>
                <field name="instruction"/>
                <field name="code"/>
                <field name="times"/>
            </tree>
        </field>
    </record>

    <record id="view_prescription_instruction_search" model="ir.ui.view">
        <field name="name">his.prescription_instruction.search</field>
        <field name="model">his.prescription_instruction</field>
        <field name="arch" type="xml">
            <search>
                <field name="instruction"/>
                <field name="code"/>
                <field name="times"/>
            </search>
        </field>
    </record>


    <record id="action_prescription_instruction" model="ir.actions.act_window">
        <field name="name">Prescription Instructions</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">his.prescription_instruction</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_child': 1}</field>
        <field name="search_view_id" ref="his.view_prescription_instruction_search"/>
    </record>

    <menuitem id="menu_prescription_instructions"
              name="Prescription Instructions"
              parent="his.menu_prescription_configurations"
              action="action_prescription_instruction"
              sequence="12"/>
</odoo>