<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_prescription_template_form" model="ir.ui.view">
        <field name="name">his.prescription_template.form</field>
        <field name="model">his.prescription_template</field>
        <field name="arch" type="xml">
            <form>
                    <group col="12" class="items-wrapper">
                        <group colspan="12">
                            <field name="name"/>
                        </group>
                        <group colspan="12">
                            <field name="company_id" invisible="True"/>
                        </group>
                        <group col="12" colspan="12">
                            <group colspan="6">
                                <field name="department_id"/>
                            </group>
                            <group colspan="6">
                                <field name="employee_id"/>
                            </group>
                        </group>
                        <group col="12" colspan="12">
                            <group colspan="6">
                                <field name="services"/>
                            </group>
                            <group colspan="6">
                                <field name="diagnosis"/>
                            </group>
                        </group>
                    </group>
            </form>
        </field>
    </record>

    <record id="view_prescription_template_tree" model="ir.ui.view">
        <field name="name">his.prescription_template.tree</field>
        <field name="model">his.prescription_template</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="department_id"/>
                <field name="employee_id"/>
                <field name="services"/>
                <field name="diagnosis"/>
            </tree>
        </field>
    </record>

    <record id="view_prescription_template_search" model="ir.ui.view">
        <field name="name">his.prescription_template.search</field>
        <field name="model">his.prescription_template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="services"/>
            </search>
        </field>
    </record>


    <record id="action_prescription_template" model="ir.actions.act_window">
        <field name="name">Prescription Templates</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">his.prescription_template</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_child': 1}</field>
        <field name="search_view_id" ref="his.view_prescription_template_search"/>
    </record>

    <menuitem id="menu_prescription_template"
              name="Prescription Templates"
              parent="his.menu_prescription_configurations"
              action="action_prescription_template"
              sequence="12"/>
</odoo>