<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_caution_form" model="ir.ui.view">
        <field name="name">his.caution.form</field>
        <field name="model">his.caution</field>
        <field name="arch" type="xml">
            <form>
                <group class="items-wrapper" colspan="12" col="12">
                    <group colspan="12" col="12" class="tw-border tw-rounded-lg !tw-pt-4 !tw-px-4 tw-relative">
                        <span class="tw-absolute tw-z-5 tw-bg-white tw-top-[-10px] tw-left-3 tw-whitespace-nowrap tw-w-auto">
                            Patient information</span>
                        <group colspan="12">
                            <field name="patient_id" domain="[('id','=',patient_id)]"
                                   options="{'no_edit':True,'no_create':True,'no_open':True}" no_open="True"/>
                        </group>
                        <group colspan="6">
                            <field name="gender"/>
                        </group>
                        <group colspan="6">
                            <field name="age"/>
                        </group>

                        <group colspan='12' col='12'>
                            <group colspan="6" col='12'>
                                <field name="blood_group"/>
                            </group>
                            <group colspan="3" col='12'>
                                <field name="height"/>
                            </group>
                            <group colspan="3" col='12'>
                                <field name="weight"/>
                            </group>
                        </group>

                    </group>
                    <group colspan="12" col="12" class="tw-border tw-rounded-lg !tw-pt-4 !tw-px-4 tw-relative !tw-mt-5">
                        <span class="tw-absolute tw-z-5 tw-bg-white tw-top-[-10px] tw-left-3 tw-whitespace-nowrap tw-w-auto">
                            Viral marker </span>
                        <group colspan="3">
                            <field name="is_hiv"/>
                        </group>
                        <group colspan="3">
                            <field name="is_vdrl"/>
                        </group>
                        <group colspan="3">
                            <field name="is_hbsag"/>
                        </group>
                        <group colspan="3">
                            <field name="is_anti_hcv"/>
                        </group>
                        <group colspan="3">
                            <field name="is_etc"/>
                        </group>
                        <group colspan="3">
                            <field name="is_anti_hbs_igm"/>
                        </group>
                        <group colspan="3">
                            <field name="is_anti_hav_igm"/>
                        </group>
                        <group colspan="3">
                            <field name="is_rw"/>
                        </group>
                        <group colspan="12">
                            <field name="viral_comment"/>
                        </group>
                    </group>
                    <group colspan="12" col="12" class="tw-border tw-rounded-lg !tw-pt-4 !tw-px-4 tw-relative !tw-mt-5">
                        <span class="tw-absolute tw-z-5 tw-bg-white tw-top-[-10px] tw-left-3 tw-whitespace-nowrap tw-w-auto">
                            Drug &amp; Allergy </span>
                        <group col="12" colspan="6">
                            <field name="is_penicillin"/>
                        </group>
                        <group col="12" colspan="6">
                            <field name="is_radio_contrast"/>
                        </group>
                        <group colspan="12">
                            <field name="drug_comment"/>
                        </group>
                    </group>
                    <group colspan="12" col="12" class="tw-border tw-rounded-lg !tw-pt-4 !tw-px-4 tw-relative !tw-mt-5">
                        <span class="tw-absolute tw-z-5 tw-bg-white tw-top-[-10px] tw-left-3 tw-whitespace-nowrap tw-w-auto">
                            Medicine Reaction </span>
                        <group col="12" colspan="12">
                            <field name="product_id" options="{'no_edit':True,'no_create':True}" no_open="True"/>
                        </group>
                        <group col="12" colspan="12">
                            <field name="product_ids" class="close-add-line">
                                <tree string="Medicine Reaction" edit="0" create="0" delete="0">
                                    <!-- <field name="default_code"/> -->
                                    <field name="name"/>
                                    <field name="categ_id"/>
                                    <!-- <field name="lst_price"/> -->
                                    <!-- <field name="type"/> -->
                                </tree>
                            </field>
                        </group>
                    </group>
                    <!-- <group colspan="12" col="12" class="tw-border tw-rounded-lg !tw-pt-4 !tw-px-4 tw-relative !tw-mt-5">
                        <span class="tw-absolute tw-z-5 tw-bg-white tw-top-[-10px] tw-left-3 tw-whitespace-nowrap tw-w-auto">
                            Specific findings </span>
                        <group col="12" colspan="2">
                            <field name="is_mrcs"/>
                        </group>
                        <group col="12" colspan="2">
                            <field name="is_vre"/>
                        </group>
                        <group col="12" colspan="2">
                            <field name="is_afb"/>
                        </group>
                        <group col="12" colspan="2">
                            <field name="is_tb"/>
                        </group>
                        <group col="12" colspan="2">
                            <field name="is_c_diff"/>
                        </group>
                        <group col="12" colspan="2">
                            <field name="is_fungus"/>
                        </group>
                        <group col="12" colspan="12">
                            <field name="comment"/>
                        </group>
                    </group> -->
                </group>
                <footer>
                    <button name="action_save_caution" string="Save" type="object"
                            class="tw-bg-green-500 tw-text-white"/>
                    <button name="action_cancel" string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_caution_tree" model="ir.ui.view">
        <field name="name">his.caution.tree</field>
        <field name="model">his.caution</field>
        <field name="arch" type="xml">
            <tree>
                <field name="patient_id"/>
                <field name="gender"/>
                <field name="age"/>
                <field name="is_hiv"/>
                <field name="is_vdrl"/>
            </tree>
        </field>
    </record>

    <record id="view_caution_search" model="ir.ui.view">
        <field name="name">his.caution.search</field>
        <field name="model">his.caution</field>
        <field name="arch" type="xml">
            <search>
                <field name="patient_id"/>
                <field name="gender"/>
                <field name="age"/>
                <field name="is_hiv"/>
                <field name="is_vdrl"/>
            </search>
        </field>
    </record>


    <record id="action_caution" model="ir.actions.act_window">
        <field name="name">caution</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">his.caution</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_child': 1, 'search_default_category_id': 1}</field>
        <field name="search_view_id" ref="his.view_caution_search"/>
    </record>

    <menuitem id="menu_caution" name="caution" parent="his.menu_other_configurations" action="action_caution" sequence="27"/>
</odoo>