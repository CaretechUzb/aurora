<?xml version="1.0" encoding="UTF-8" ?>
<odoo>


    <record id="view_referral_source_tree" model="ir.ui.view">
        <field name="name">res.partner.tree</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree>
                <field name="id"/>
                <field name="code" optional="hide"/>
                <field name="name" optional="show" string="Full name"/>
                <field name="employee" optional="show"/>
                <field name="first_name" optional="hide"/>
                <field name="middle_name" optional="hide"/>
                <field name="last_name" optional="hide"/>
                <field name="phone" string="Phone number 1" optional="hide"/>
                <field name="mobile" string="Phone number 2" optional="hide"/>
                <field name="card_num" optional="hide"/>
                <field name="state_id" string="Region" optional="hide"/>
                <field name="district_id" optional="hide"/>
                <field name="created_date" optional="hide"></field>
                <field name="commercial_company_name" string="Work company" optional="hide"/>
                <field name="email" string="Email" optional="hide"/>
                <field name="manager_id" optional="show"/>
                <field name="function" string="Job Position" optional="hide"/>
                <field name="category_id" string="Category" optional="show" widget='many2many_tags'/>
                <field name="referral_count" optional="show"/>
                <field name="calculation_type" optional="hide"/>
                <field name="total_earnings" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_referral_source_search" model="ir.ui.view">
        <field name="name">res.partner.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="id"/>
                <field name="category_id"/>
                <field name="phone"/>
                <field name="referral_bonus_type"/>
                <field name="referral_bonus_value"/>
                <field name="calculation_type"/>
                <filter string="Referrals or employees" name="referrals"
                        domain="['|', ('employee', '=', True), ('category_id', '!=', False)]"/>
                <!-- <searchpanel>

                </searchpanel> -->
            </search>
        </field>
    </record>

    <record id="referral_category_view_form" model="ir.ui.view">
        <field name="name">referral_category.view.form</field>
        <field name="model">res.partner.category</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <field name="name" required="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="referral_source_categroy_view_tree" model="ir.ui.view">
        <field name="name">referral_source_categroy.view.tree</field>
        <field name="model">res.partner.category</field>
        <field name="arch" type="xml">
            <tree string="">
                <field name="id" optional="hide"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="referral_source_view_form" model="ir.ui.view">
        <field name="name">referral.source.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form>
            <div class="tw-flex tw-flex-wrap h-100">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="his.action_referral_doctor_share_and_bonus"
                            type="action"
                            class="oe_stat_button"
                            icon="fa-person"
                            title="fa-person">
                            <field name="referral_count" widget="statinfo" string="Referral Bonus List"/>
                        </button>
                    </div>
                    <field name="name" attrs="{'invisible': [('is_patient', '=', True)]}"/>
                    <field name="is_patient" invisible="1"/>
                    <group>
                        <group string="Bonus Type/Value" col="12" colspan="12">
                           <group col="12" colspan="12">
                                <group col="12" colspan="3" attrs="{'invisible': [('is_patient', '=', False)]}">
                                    <field name="last_name"/>
                                </group>
                                <group col="12" colspan="4" attrs="{'invisible': [('is_patient', '=', False)]}">
                                    <field name="first_name"/>
                                </group>
                                <group col="12" colspan="4" attrs="{'invisible': [('is_patient', '=', False)]}">
                                    <field name="middle_name"/>
                                </group>

                                <group col="12" colspan="1">
                                    <field name="is_company"/>
                                </group>
                           </group>
                           <group col="12" colspan="12">
                                <group col="12" colspan="4">
                                    <field name="phone" string="Phone number 1"/>
                                </group>
                                <group col="12" colspan="4">
                                    <field name="mobile" string="Phone number 2"/>
                                </group>
                                <group col="12" colspan="4">
                                    <field name="card_num"/>
                                </group>
                           </group>
                           <group col="12" colspan="12">
                                <group col="12" colspan="6">
                                    <field
                                        name="state_id"
                                        placeholder="Region"
                                        options="{'no_create':1,'no_open': True, 'limit': 100}"
                                        domain="[('country_id', '=', 'UZ')]"/>
                                </group>
                                <group col="12" colspan="6">
                                    <field name="district_id"
                                        string="District: "
                                        placeholder="District"
                                        options="{'no_create':1,'no_open': True}"
                                        domain="[('state_id','=',state_id)]"/>
                                </group>
                           </group>
                           <group col="12" colspan="12">
                                <group col="12" colspan="4">
                                    <field name="commercial_company_name" string="Work company" readonly="0"/>
                                </group>
                                <group col="12" colspan="4">
                                    <field name="function" string="Job Position"/>
                                </group>
                                <group col="12" colspan="4">
                                    <field name="manager_id"/>
                                </group>
                           </group>
                           <group col="12" colspan="12">
                                <group col="12" colspan="6">
                                    <field name="code"/>
                                </group>
                                <group col="12" colspan="6">
                                    <field name="category_id" widget='many2many_tags' string="Category" options="{'no_open':True,'no_create':True}"/>
                                </group>
                           </group>
                            <group col="12" colspan="12">
                                <group col="12" colspan="6">
                                    <field name="referral_bonus_type"/>
                                </group>
                                <group col="12" colspan="6">
                                    <field name="referral_bonus_value" attrs="{'invisible': [('referral_bonus_type', '=', 'formula')]}"/>
                                    <field name="formula" attrs="{'invisible': [('referral_bonus_type', '!=', 'formula')], 'required': [('referral_bonus_type', '=', 'formula')]}" placeholder="e.g., price_subtotal * 0.10"/>
                                </group>
                            </group>
                            <group col="12" colspan="12" attrs="{
                                'invisible': ['|', ('referral_bonus_type','!=','percent'), ('referral_bonus_type', '=', 'formula')]
                            }">
                                <field name="calculation_type"/>
                            </group>
                            <group col="12" colspan="12" attrs="{'invisible': [('referral_bonus_type', '!=', 'formula')]}">
                                <div class="alert alert-info" role="alert">
                                    <strong>Formula Help:</strong>
                                    <p>Available variables: <code>price_subtotal</code>, <code>discount_total</code>, <code>price_total</code>, <code>quantity</code>, <code>price_tax</code>, <code>price</code>, <code>actual_price</code></p>
                                    <p><strong>Examples:</strong> <code>price_subtotal * 0.10</code>, <code>min(actual_price * 0.15, 500)</code>, <code>price_subtotal * 0.15 if quantity &gt; 5 else price_subtotal * 0.08</code></p>
                                </div>
                            </group>
                            <!-- <group col="12" colspan="12">
                                <field name="product_type_id" widget='many2many_tags'
                                    options="{'no_open':True,'no_create':True}"/>
                            </group> -->
                            <group col="12" colspan="12">
                                    <field name="referral_source_by_product_type_ids">
                                        <tree editable="bottom">
                                            <field name="product_type_id" options="{'no_open':True,'no_create':True}"/>
                                            <field name="referral_bonus_type"/>
                                            <field name="referral_bonus_value" optional="show"/>
                                            <field name="internal_amount"   optional="show"/>
                                            <field name="external_amount" optional="show" />
                                            <field name="calculation_type" optional="show"/>
                                            <field name="internal_formula" optional="hide" />
                                            <field name="external_formula" optional="hide" />
                                        </tree>
                                    </field>
                                </group>
                            <group col="12" colspan="12">
                                <field name="referral_source_by_product_category_ids">
                                    <tree editable="bottom">
                                        <field name="product_category_id" options="{'no_open':True,'no_create':True}"/>
                                        <field name="referral_bonus_type"/>
                                        <field name="referral_bonus_value" optional="show"/>
                                        <field name="internal_amount" optional="show"/>
                                        <field name="external_amount" optional="show"/>
                                        <field name="calculation_type" optional="show"/>
                                        <field name="internal_formula" optional="hide"/>
                                        <field name="external_formula" optional="hide"/>
                                    </tree>
                                </field>
                            </group>
                            <group col="12" colspan="12">
                                <field name="referral_source_by_service_ids">
                                    <tree editable="bottom">
                                        <field name="service_id"
                                                options="{'no_open':True,'no_create':True}"/>
                                        <field name="referral_bonus_type"/>
                                        <field name="referral_bonus_value"  optional="show"/>
                                        <field name="internal_amount" optional="show" />
                                        <field name="external_amount" optional="show" />
                                        <field name="calculation_type" optional="show"/>
                                        <field name="internal_formula"  optional="hide" />
                                        <field name="external_formula" optional="hide" />
                                    </tree>
                                </field>
                            </group>
                        </group>
                    </group>
                    <group string="Comment" name='comment'>
                        <field name="comment" nolabel="1"/>
                    </group>
                    <div class="oe_chatter">
                        <field name="message_ids" widget="mail_thread" />
                    </div>
                </sheet>
                </div>
            </form>
        </field>
    </record>
