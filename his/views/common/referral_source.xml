    <record id="referral_source_categry_action" model="ir.actions.act_window">
        <field name="name">Referral Source Category</field>
        <field name="res_model">res.partner.category</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('referral_source_categroy_view_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('referral_category_view_form')})]"/>
    </record>

    <record id="view_res_partner_filter_referrals" model="ir.ui.view">
        <field name="name">res.partner.search.referrals</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="after">
                <separator/>
                <filter string="Referrals" name="referrals"
                        domain="['|', ('category_id', '!=', False), ('employee', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <record id="action_contacts_referrals" model="ir.actions.act_window">
        <field name="name">Contacts</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form,activity</field>
        <field name="search_view_id" ref="base.view_res_partner_filter"/>
        <field name="context">{'default_is_company': True, 'search_default_referrals': 1}</field>
    </record>

    <menuitem id="menu_referral_Source"
            name="Referral Source"
            parent="menu_patient_main"
            action="action_contacts_referrals"
            groups="his.group_his_admin,his.group_his_manager"
            sequence="3"/>

    <record id="action_referral_source" model="ir.actions.act_window">
        <field name="name">Referral Sources</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_referrals': 1}</field>
        <field name="search_view_id" ref="view_referral_source_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_referral_source_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('referral_source_view_form')})]"/>
    </record>

    <menuitem
            id="referral_menu"
            name="Referral"
            parent="his.menu_configurations"
            groups="group_his_admin"
            sequence="95"/>

    <menuitem id="menu_referral_Source2"
            name="Referral Source List"
            parent="referral_menu"
            action="action_referral_source"
            groups="group_his_admin"
            sequence="1"/>

    <menuitem id="menu_referral_source_category2"
            name="Referral Source Category"
            parent="referral_menu"
            action="referral_source_categry_action"
            groups="group_his_admin"
            sequence="2"/>

