<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_account_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.his.account</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="50"/>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='default_accounts']//div[hasclass('col-12','col-lg-6','o_setting_box')][2]//div[hasclass('content-group')]" position="inside">
                <div class="row mt8">
                    <label for="due_from_account_id" class="col-lg-5 o_light_label"/>
                    <field name="due_from_account_id"/>
                </div>
                <div class="row mt8">
                    <label for="due_to_account_id" class="col-lg-5 o_light_label"/>
                    <field name="due_to_account_id"/>
                </div>
                <div class="row mt8">
                    <label for="due_fromto_payment_journal_id" class="col-lg-5 o_light_label"/>
                    <field name="due_fromto_payment_journal_id"/>
                </div>
            </xpath>

            <!-- Add Share outstanding payments field to Customer Payments section -->
            <xpath expr="//div[@id='pay_invoice_online_setting_container']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="share_outstanding_payments"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="share_outstanding_payments"/>
                        <div class="text-muted">
                            Enable sharing of outstanding payments across companies
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
