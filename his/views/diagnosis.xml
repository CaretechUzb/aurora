<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_diagnosis_form" model="ir.ui.view">
        <field name="name">his.diagnosis.form</field>
        <field name="model">his.diagnosis</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code" />
                        <field name="name" />
                        <field name="category_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>




    <record id="view_diagnosis_tree" model="ir.ui.view">
        <field name="name">his.diagnosis.tree</field>
        <field name="model">his.diagnosis</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code" />
                <field name="name" />
                <field name="category_id" />
            </tree>
        </field>
    </record>

    <record id="view_diagnosis_search" model="ir.ui.view">
        <field name="name">his.diagnosis.search</field>
        <field name="model">his.diagnosis</field>
        <field name="arch" type="xml">
            <search>
                <field name="code" />
                <field name="name" />
                <group expand="0" string="Group">
                    <filter string="Category" name="category_id"
                        context="{'group_by':'category_id'}" />
                </group>
                <searchpanel>
                    <field name="category_id" />
                </searchpanel>
            </search>
        </field>
    </record>


    <record id="action_diagnosis" model="ir.actions.act_window">
        <field name="name">Diagnosis</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">his.diagnosis</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_child': 1, 'search_default_category_id': 1}</field>
        <field name="search_view_id" ref="his.view_diagnosis_search" />
    </record>

    <menuitem id="menu_diagnosis"
        name="Diagnosis"
        parent="his.menu_diagnosis_configurations"
        action="action_diagnosis"
        sequence="7" />

    <record id="view_selected_diagnosis_search" model="ir.ui.view">
        <field name="name">selected.diagnosis.search</field>
        <field name="model">his.selected_diagnosis</field>
        <field name="arch" type="xml">
            <search string="Search Diagnosis">
                <field name="code" />
                <field name="name" />
            </search>
        </field>
    </record>

    <record id="view_selected_diagnosis_form" model="ir.ui.view">
        <field name="name">his.selected_diagnosis.form</field>
        <field name="model">his.selected_diagnosis</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code" />
                        <field name="name" />
                        <field name="type" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>