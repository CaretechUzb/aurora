<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_payer_template_form" model="ir.ui.view">
        <field name="name">his.payer_template.form</field>
        <field name="model">his.payer_template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="discount"/>
                        <field name="products_ids"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_payer_template_tree" model="ir.ui.view">
        <field name="name">his.payer_template.tree</field>
        <field name="model">his.payer_template</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="view_payer_template_search" model="ir.ui.view">
        <field name="name">his.payer_template.search</field>
        <field name="model">his.payer_template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/></search>
        </field>
    </record>


    <record id="action_payer_template" model="ir.actions.act_window">
        <field name="name">Payer Template</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">his.payer_template</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_child': 1}</field>
        <field name="search_view_id" ref="his.view_payer_template_search"/>
    </record>

    <menuitem id="menu_payer_template"
              name="Payer Template"
              parent="his.menu_payer_configurations"
              action="action_payer_template"
              sequence="5"/>

</odoo>