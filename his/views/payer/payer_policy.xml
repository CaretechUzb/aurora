<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_payer_policy_readonly_form" model="ir.ui.view">
        <field name="name">his.payer_policy.form</field>
        <field name="model">his.payer_policy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="is_readonly" invisible="1"/>
                        <field name="full_name"/>
                        <field name="passport_serial"/>
                        <field name="phone_number" widget="phone_number"/>
                        <field name="pinfl" options="{'mask': '9999 9999 9999 99'}" widget="mask"/>
                        <field name="patient_id" attrs="{'readonly': [('is_readonly','=',True)]}"/>
                        <field name="policy_number"/>
                        <!-- <field name="policy_amount"/> -->
                        <field name="from_date"/>
                        <field name="to_date"/>
                        <field name="template_id"/>
                        <field name="is_active"/>
                        <field name="payer_policy_limit_ids">
                            <tree>
                                <field name="date"/>
                                <field name="company_id" />
                                <field name="amount"/>
                                <field name="create_uid"/>
                                <button icon="fa-arrow-right" title="fa-arrow-right" name="action_open_in_current" type="object" class="oe_highlight"/>
                            </tree>
                        </field>
                        <field name="contract_id" readonly="1"/>
                        <field name="payer_company_id"  readonly="1"/>
                        <div class="oe_chatter" style="display:block !important;">
                            <field name="message_follower_ids"/>
                            <field name="message_ids" options="{'post_refresh': 'recipients'}"/>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_payer_policy_form" model="ir.ui.view">
        <field name="name">his.payer_policy.form</field>
        <field name="model">his.payer_policy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="full_name"/>
                        <field name="passport_serial" options="{'mask': 'passport_serial_mask','maskFromField':True}"/>
                        <field name="phone_number" widget="phone_number"/>
                        <field name="pinfl" options="{'mask': '9999 9999 9999 99'}" widget="mask"/>
                        <field name="birth_date"
                               options="{ 'datepicker': {'format':'dd/MM/yyyy','minDate':'01-01-1900','maxDate': 'today' } }"/>
                        <field name="gender" widget="radio"/>
                        <field name="patient_id" options="{'no_create_edit': True, 'no_open': True}"/>
                        <field name="policy_number"/>
                        <!-- <field name="policy_amount"/> -->
                        <field name="from_date"/>
                        <field name="to_date"/>
                        <field name="is_active"/>
                        <field name="payer_policy_limit_ids">
                            <tree default_order="date desc">
                                <field name="company_id" />
                                <field name="date"/>
                                <field name="amount"/>
                                <field name="create_uid"/>
                                <button icon="fa-arrow-right" title="fa-arrow-right" name="action_open_in_current" type="object" class="oe_highlight"/>
                            </tree>
                        </field>
                        <field name="contract_id" readonly="1"/>
                        <field name="payer_company_id" readonly="1"/>
                        <button name="action_match_and_connect" string="Match and Connect" type="object"
                                class="btn-primary" context="{'active_id': active_id}"/>

                    </group>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids" options="{'post_refresh': 'recipients'}"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_payer_policy_tree" model="ir.ui.view">
        <field name="name">his.payer_policy.tree</field>
        <field name="model">his.payer_policy</field>
        <field name="arch" type="xml">
            <tree>
                <field name="patient_id"/>
                <field name="policy_number"/>
                <field name="payer_company_id"/>
                <!-- <field name="policy_amount"/> -->
                <!-- <field name="used_amount"/> -->
                <!-- <field name="balance"/> -->
                <field name="from_date"/>
                <field name="to_date"/>
                <field name="is_active"/>
            </tree>
        </field>
    </record>
    <record id="view_payer_policy_search" model="ir.ui.view">
        <field name="name">his.payer_policy.search</field>
        <field name="model">his.payer_policy</field>
        <field name="arch" type="xml">
            <search>
                <field name="full_name"/>
                <field name="pinfl"/>
                <field name="patient_id"/>
                <field name="policy_number"/>
                <!-- <field name="policy_amount"/> -->
                <field name="from_date"/>
                <field name="to_date"/>
                <field name="is_active"/>
                <field name="payer_policy_limit_ids"/>
                <field name="contract_id" invisible="1"/>
                <field name="payer_company_id" invisible="1"/>
                <filter name="patient_not_attached" string="Patient is not attached"
                        domain="[('patient_id', '=', False)]"/>
                <group expand="1" string="Group">
                    <filter string="Company" name="group_date" context="{'group_by':'payer_company_id'}"/>
                    <filter string="Contract" name="group_patient_id" context="{'group_by':'contract_id'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="action_payer_policy" model="ir.actions.act_window">
        <field name="name">Payer Policy</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">his.payer_policy</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_child': 1}</field>
        <field name="search_view_id" ref="his.view_payer_policy_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('view_payer_policy_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_payer_policy_form')})]"/>
    </record>

    <menuitem id="menu_payer_policy"
              name="Payer Policy"
              parent="his.menu_payer_configurations"
              action="action_payer_policy"
              sequence="1"/>


    <record id="view_payer_policy_patient_total_view_form" model="ir.ui.view">
        <field name="name">his.payer_policy_patient_total.form</field>
        <field name="model">his.payer_policy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="full_name"/>
                        <field name="passport_serial"/>
                        <field name="phone_number" widget="phone_number"/>
                        <field name="pinfl" options="{'mask': '9999 9999 9999 99'}" widget="mask"/>
                        <field name="patient_id" options="{'no_create_edit': True, 'no_open': True}"/>
                        <field name="policy_number"/>
                        <!-- <field name="policy_amount"/> -->
                        <field name="from_date"/>
                        <field name="to_date"/>
                        <field name="is_active"/>
                        <field name="payer_policy_limit_ids">
                            <tree>
                                <field name="amount"/>
                                <field name="date"/>
                                <field name="create_uid"/>
                                <button icon="fa-arrow-right" title="fa-arrow-right" name="action_open_in_current" type="object" class="oe_highlight"/>
                            </tree>
                        </field>
                        <field name="contract_id" readonly="1"/>
                        <div class="oe_chatter" style="display:block !important;">
                            <field name="message_follower_ids"/>
                            <field name="message_ids" options="{'post_refresh': 'recipients'}"/>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_payer_policy_registration_form" model="ir.ui.view">
        <field name="name">his.payer_policy_registration.form</field>
        <field name="model">his.payer_policy</field>
        <field name="arch" type="xml">
            <form>
                <group colspan="12" col="12" class="items-wrapper">
                    <field name="template_domain" invisible="1"/>
                    <field name="payer_company_id"/>
                    <field name="contract_id" domain="[('payer_company_id','=',payer_company_id)]"/>
                    <field name="template_id" domain="template_domain"/>
                    <field name="policy_number"/>
                    <!-- <field name="policy_amount" widget="mask"
                           options="{ 'currency': True, 'rightAlign': False, 'groupSeparator': ' ', 'digits': 2 }"/> -->
                    <field name="from_date"/>
                    <field name="to_date"/>
                    <field name="full_name"/>
                    <field name="passport_serial"/>
                    <field name="phone_number" widget="phone_number"/>
                    <field name="pinfl" options="{'mask': '9999 9999 9999 99'}" widget="mask"/>
                    <field name="patient_id" options="{'no_create_edit': True, 'no_open': True}" class='readonly-input'/>
                    <!-- <field name="payer_policy_limit_ids"/> -->
                    <div class="oe_chatter" style="display:block !important;">
                        <field name="message_follower_ids"/>
                        <field name="message_ids" options="{'post_refresh': 'recipients'}"/>
                    </div>

                </group>
                <footer>
                    <button name="action_create_and_add_to_registration" string="Create" type="object"
                            class="tw tw-btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

