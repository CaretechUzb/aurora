        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <!-- Misol: Settings sahifasiga yangi block qo‘shish -->
            <xpath expr="//div[@id='active_user_setting']//div[hasclass('o_setting_right_pane')]" position="after">
                <div class="app_settings_block mt16">
                    <div class="o_setting_right_pane">
                        <label for="title" class="col-sm-1 col-form-label"/>
                        <field name="title"/>
                    </div>
                </div>

            </xpath>

            <!-- Append HIS application version to the bottom of the About section. -->
            <xpath expr="//div[@name='about_setting_container']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_right_pane">
                        <label for="app_version" string="Aurora version"/>
                        <div class="content-group mt16">
                            <field name="app_version" readonly="1"/>
                        </div>
                    </div>
                </div>
            </xpath>

        </field>
    </record>

</odoo>
