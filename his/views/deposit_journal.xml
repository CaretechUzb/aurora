<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_deposit_journal_form" model="ir.ui.view">
        <field name="name">his.deposit_journal.form</field>
        <field name="model">his.deposit_journal</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="account_payment_id"/>
                        <field name="account_move_id"/>
                        <field name="amount"/>
                        <field name="operation"/>
                        <field name="datetime"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_deposit_journal_tree" model="ir.ui.view">
        <field name="name">his.deposit_journal.tree</field>
        <field name="model">his.deposit_journal</field>
        <field name="arch" type="xml">
            <tree create="0">
                <field name="partner_id"/>
                <field name="account_payment_id"/>
                <field name="account_move_id"/>
                <field name="amount"/>
                <field name="operation"/>
                <field name="datetime"/>
                <field name="create_uid"/>
            </tree>
        </field>
    </record>

    <record id="view_deposit_journal_search" model="ir.ui.view">
        <field name="name">his.deposit_journal.search</field>
        <field name="model">his.deposit_journal</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="account_payment_id"/>
                <field name="account_move_id"/>
                <field name="amount"/>
                <field name="operation"/>
                <field name="datetime"/>
                <field name="create_uid"/>
                <filter string="TopUp" name="operation" domain="[('operation', '=', 'top_up')]"/>
                <filter string="Return" name="operation" domain="[('operation', '=', 'return')]"/>
                <filter string="Payment" name="operation" domain="[('operation', '=', 'payment')]"/>
            </search>
        </field>
    </record>


    <record id="action_deposit_journal" model="ir.actions.act_window">
        <field name="name">Deposit Journal</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">his.deposit_journal</field>
        <field name="view_mode">tree</field>
        <field name="context">{'search_default_filter_child': 1}</field>
        <field name="search_view_id" ref="his.view_deposit_journal_search"/>
    </record>

    <menuitem id="menu_deposit_journal"
              name="Deposit Journal"
              parent="his.menu_other_configurations"
              action="action_deposit_journal"
              sequence="1"/>
</odoo>