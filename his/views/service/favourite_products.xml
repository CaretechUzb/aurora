<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_favourite_products_form" model="ir.ui.view">
        <field name="name">his.favourite_products.form</field>
        <field name="model">his.favourite_products</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="product_id"/>
                        <field name="type" widget="radio"/>
                        <field name="department_id" attrs="{'invisible':[('type','=','doctor')]}"/>
                        <field name="doctor_id" attrs="{'invisible':[('type','=','department')]}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_favourite_products_tree" model="ir.ui.view">
        <field name="name">his.favourite_products.tree</field>
        <field name="model">his.favourite_products</field>
        <field name="arch" type="xml">
            <tree>
                <field name="product_id"/>
                <field name="type"/>
                <field name="department_id"/>
                <field name="doctor_id"/>
            </tree>
        </field>
    </record>

    <record id="view_favourite_products_search" model="ir.ui.view">
        <field name="name">his.favourite_products.search</field>
        <field name="model">his.favourite_products</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="type"/>
                <field name="department_id"/>
                <field name="doctor_id"/>
            </search>
        </field>
    </record>


    <record id="action_favourite_products" model="ir.actions.act_window">
        <field name="name">Favourite Products</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">his.favourite_products</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_child': 1}</field>
        <field name="search_view_id" ref="his.view_favourite_products_search"/>
    </record>
</odoo>