<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="his_room_type_form_view" model="ir.ui.view">
            <field name="name">his.room.type.form</field>
            <field name="model">his.room.type</field>
            <field name="arch" type="xml">
                <form string="Type Name">
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="Title"/>
                            </h1>
                        </div>
                        <div class="oe_chatter">
                            <field name="message_follower_ids"/>
                            <field name="message_ids" options="{'post_refresh': 'recipients'}"/>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="his_room_type_tree_view" model="ir.ui.view">
            <field name="name">his.room.type.tree</field>
            <field name="model">his.room.type</field>
            <field name="arch" type="xml">
                <tree string="ModelTitle">
                    <field name="create_date"/>
                    <field name="name"/>
                </tree>
            </field>
        </record>

        <record id="his_room_type_act_window" model="ir.actions.act_window">
            <field name="name">Room Type</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">his.room.type</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem name="Room Type" id="his_room_type_menu" parent="menu_room_configurations" action="his_room_type_act_window"/>

    </data>
</odoo>