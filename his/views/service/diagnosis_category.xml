<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_diagnosis_category_form" model="ir.ui.view">
        <field name="name">his.diagnosis_category.form</field>
        <field name="model">his.diagnosis_category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="parent_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_diagnosis_category_tree" model="ir.ui.view">
        <field name="name">his.diagnosis_category.tree</field>
        <field name="model">his.diagnosis_category</field>
        <field name="arch" type="xml">
            <tree js_class="uic_tree_list">
                <field name="name" options="{'handler': '1'}" />
                <field invisible="1" name="id"/>
                <field name="parent_id"/>
            </tree>
        </field>
    </record>

    <record id="view_diagnosis_category_search" model="ir.ui.view">
        <field name="name">his.diagnosis_category.search</field>
        <field name="model">his.diagnosis_category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="parent_id"/>
            </search>
        </field>
    </record>


    <record id="action_diagnosis_category" model="ir.actions.act_window">
        <field name="name">Diagnosis Category</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">his.diagnosis_category</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_child': 1}</field>
        <field name="search_view_id" ref="his.view_diagnosis_category_search"/>
    </record>

    <menuitem id="menu_diagnosis_category"
              name="Diagnosis Category"
              parent="his.menu_diagnosis_configurations"
              action="action_diagnosis_category"
              groups="his.group_his_admin,his.group_his_manager"
              sequence="7"/>
</odoo>