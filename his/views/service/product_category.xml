<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="view_product_category_form_inherit">
        <field name="name">product.category.product.form.inherit</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="is_his" />
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <!--                    <group col="12" colspan="12">-->
                <!--                        <group col="12" colspan="6">-->
                <!--                            <field name="can_online_appointment"></field>-->
                <!--                        </group>-->
                <!--                    </group>-->
                <group col="12" colspan="12">
                    <group col="12" colspan="5">
                        <field name="description" widget="ck-editor"></field>
                    </group>
                    <group col="12" colspan="2">
                        <field name="sequence"></field>
                    </group>
                    <group col="12" colspan="2" name="lis_category">
                        <field name="is_lis_category"></field>
                    </group>
                </group>
                <group name="share" string="Doctor Share">
                    <group col="12" colspan="12">
                        <group col="12" colspan="6">
                            <field name="share_type"></field>
                        </group>
                        <group col="12" colspan="6">
                            <field name="share_value"></field>
                        </group>
                    </group>
                </group>
                <group name="bonus" string="Doctor Bonus" invisible="1">
                    <!-- <group col="12" colspan="12">
                        <group col="12" colspan="6">
                            <field name="recommendation_bonus_type"></field>
                        </group>
                        <group col="12" colspan="6">
                            <field name="recommendation_bonus_value"></field>
                        </group>
                    </group> -->
                </group>
                <group name="schedule" string="Schedule Options">
                    <group col="12" colspan="12">
                        <group col="12" colspan="1">
                            <field name="icon" widget="image" options="{'size': [250, 250]}"></field>
                        </group>
                        <group col="12" colspan="2">
                            <field name="available_in_registration"></field>
                        </group>
                        <group col="12" colspan="2">
                            <field name="can_online_appointment"></field>
                        </group>
                        <group col="12" colspan="2">
                            <field name="is_schedulable"></field>
                        </group>
                        <group col="12" colspan="3">
                            <field name="schedule_type"></field>
                        </group>
                        <group col="12" colspan="2">
                            <field name="sorting"></field>
                        </group>
                    </group>
                </group>

                <!-- <group name="Favicon" string="Product category Favicon">
                    <group col="12" colspan="12">
                    </group>
                </group> -->
            </xpath>
        </field>
    </record>

    <record id="view_product_category_list_inherit" model="ir.ui.view">
        <field name="name">product.category.list.inherit</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_list_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='display_name']" position="before">
                <field name="sequence" widget="handle"/>
            </xpath>
        </field>
    </record>

    <record id="view_product_proxy_category_search" model="ir.ui.view">
        <field name="name">product.proxy.category.search</field>
        <field name="model">product.category</field>
        <field name="arch" type="xml">
            <search>
                <filter string="Is HIS" name="is_his" domain="[('is_his', '=', 'True')]"/>
                <!-- <searchpanel>
                    <field name="is_schedulable" string="Is Schedulable"/>
                </searchpanel> -->
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_product_category">
        <field name="name">Product category</field>
        <field name="res_model">product.category</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{
            'search_default_filter_child': 1,
            'default_is_his': True,
            'search_default_is_his': 1,
        }</field>
        <field name="search_view_id" ref="his.view_product_proxy_category_search"/>
    </record>

    <menuitem id="menu_product_category_inherit" name="Product Category"
              action="action_product_category" parent="his.menu_product_management_main"
              sequence="2" groups="his.group_his_admin,his.group_his_provisory,his.group_his_manager"/>
</odoo>
