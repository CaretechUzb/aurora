<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_product_proxy_product_form" model="ir.ui.view">
        <field name="name">product.proxy.product.form</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <form>
                <group class="items-wrapper" col="12">
                    <group colspan="12" col="12" invisible="1">
                        <field name="id"/>
                        <field name="tx_meds"/>
                        <field name="product_type_selection"/>
                        <field name="is_rx_possible"/>
                    </group>
                    <group colspan="12" col="12" name="head">
                        <group colspan="4" col="12">
                            <group colspan="12" col="12">
                                <field name="name"/>
                            </group>
                            <!-- <group colspan="12" col="12">
                                <field name="short_name" />
                            </group> -->
                            <group colspan="12" col="12">
                                <field name="uom_id"/>
                                <field name="uom_po_id" invisible="1" />
                            </group>
                            <group colspan="12" col="12">
                                <field name="type"/>
                            </group>
                            <group col="12" colspan="12">
                                <group col="12" colspan="5">
                                    <field name="list_price" string="Base Service Price"/>
                                    <field name="sync_with_doctor_fee"/>
                                </group>
                                <group col="12" colspan="5"
                                       attrs="
                                    {
                                        'invisible': [('is_schedulable', '=', False)]
                                    }">
                                    <field name="base_service_duration" string="Duration(in minute)"/>
                                </group>
                                <group colspan="2" col="12"
                                       attrs="
                                    {
                                        'invisible': [('is_schedulable','=',False)],
                                    }">
                                    <field name="priority_color" widget="color"/>
                                </group>
                                <group colspan="7" col="12"
                                       attrs="
                                    {
                                        'invisible': [('is_schedulable','!=',False)],
                                    }">
                                    <field name="priority_color" widget="color"/>
                                </group>

                            </group>
                            <group col="12" colspan="12">
                                <group colspan="12">
                                    <field name="follow_up_duration"/>
                                </group>
                                <group colspan="12">
                                    <field name="second_visit_duration"/>
                                </group>
                            </group>
                            <group col="12" colspan="12">
                                <group colspan="6">
                                    <field name="base_share_type"/>
                                </group>
                                <group colspan="6">
                                    <field name="base_share_value"/>
                                </group>
                            </group>
                            <!-- <group col="12" colspan="12">
                                <group colspan="6">
                                    <field name="base_recommendation_bonus_type"/>
                                </group>
                                <group colspan="6">
                                    <field name="base_recommendation_bonus_value"/>
                                </group>
                            </group> -->
                            <group colspan="12" col="12">
                                <group colspan="3">
                                    <field name="product_type"
                                           options="{'no_create':True, 'no_open':True}"/>
                                </group>
                                <group colspan="9" col="12">
                                    <field
                                            name="categ_id"
                                            domain="[('is_his', '=', True)]"
                                            context="{
                                            'default_is_his': True
                                        }"
                                    />
                                </group>
                            </group>
                            <group colspan="12" col="12">
                                <group colspan="6" col="12">
                                    <field name="gtin_id"/>
                                </group>
                                <group colspan="6" col="12"
                                       attrs="{
                                        'invisible': [('type', '!=', 'service')]
                                    }">
                                    <field name="equipment_id"/>
                                </group>
                            </group>
                            <group colspan="12" col="12">
                                <group colspan="12" col="12">
                                    <field name="is_cito"/>
                                </group>
                            </group>
                            <group col="12" colspan="12" invisible="1">
                                <group col="12" colspan="12"
                                       attrs="
                                        {
                                            'invisible': [('product_type_selection','!=','consultation'),('product_type_selection','!=','lab_exam')]
                                        }">
                                    <field name="default_department_id"/>
                                </group>
                            </group>

                        </group>


                        <group colspan="8" col="12">
                            <field name="service_requirements" widget="ck-editor"/>
                            <group colspan="12" col="12">
                                <field name="no_resident_price"/>
                            </group>
                            <group colspan="12" col="12">
                                <group colspan="3">
                                    <field name="age" widget="radio"/>
                                </group>
                                <group colspan="3">
                                    <field name="is_schedulable"/>
                                    <field name="categ_is_his" string="Is HIS Category"/>
                                    <field name="available_in_registration"></field>
                                </group>
                                <!-- <group colspan="3"
                                       attrs="{
                                    'invisible': [('is_schedulable', '=', False)]
                                }">
                                    <field name="schedule_type" widget="radio"/>
                                </group> -->
                                <group colspan="3"
                                       attrs="{
                                    'invisible': [('is_schedulable', '=', False)]
                                }">
                                    <field name="can_online_appointment"/>
                                    <field name="can_receive_call_back"/>
                                    <field name="sorting_to_website"/>
                                    <field name="sequence"/>
                                </group>
                               <group colspan="3">
                                   <field name="subtract_from_share_bonus"/>
                                   <field name="subtract_from_referral_bonus"/>
                               </group>
                            </group>
                            <group colspan="12" col="12">
                                <group colspan="6">
                                    <field name="package_code"/>
                                </group>
                                <group colspan="6">
                                    <field name="class_code"/>
                                </group>
                            </group>
                            <group colspan="12" col="12">
                                <group colspan="12">
                                    <field name="product_tag_ids" widget="many2many_tags"
                                           options="{'color_field': 'color'}"/>
                                </group>
                            </group>
                            <group colspan="12" col="12">
                                <group colspan="12">
                                    <field name="product_nnm_ids" widget="many2many_tags"
                                           options="{'color_field': 'color'}"/>
                                </group>
                            </group>
                            <group colspan="12" col="12">
                                <group colspan="12">
                                    <field name="snomed_id" />
                                </group>
                            </group>
                        </group>
                    </group>
                    <group colspan="12" col="12">
                        <field
                                name="doctor_branch_price_conf"
                                domain="[('service_id', '=', id)]"
                                context="{
                                'default_service_id': id
                            }">
                        </field>
                    </group>

                    <group invisible="1">
                        <field name="rx_out_host"/>
                        <field name="tx_meds"/>
                    </group>

                    <notebook name="additional_inputs">
                        <page name="addition_input_1" string="Drugs">
                            <group colspan="12" col="12">
                                <group colspan="6">
                                    <field name="calculation_type"/>
                                </group>
                                <group colspan="6">
                                    <field name="amt_unit" string="AMT Unit"
                                           attrs="{'invisible':[('calculation_type','not in',['pack', 'one_time'])]}"/>
                                </group>
                                <group colspan="6">
                                    <field name="quantity_in_pack" string="Quantity in pack"
                                           attrs="{'invisible':[('calculation_type','not in',['pack', 'one_time'])]}"/>
                                </group>
                                <group colspan="6">
                                    <field name="medical_classification_id"
                                           options="{'no_open':True,'no_create':True}"
                                           attrs="{'readonly':[('product_type_selection','!=','drug')]}"/>
                                </group>
                                <group colspan="6" invisible="1">
                                    <field name="basic_dosage"
                                           attrs="{'readonly':[('product_type_selection','!=','drug')]}"/>
                                </group>
                                <group colspan="6" invisible="1">
                                    <field name="default_no"
                                           attrs="{'readonly':[('product_type_selection','!=','drug')]}"/>
                                </group>
                                <group colspan="6" invisible="1">
                                    <field name="daily_max_amt"
                                           attrs="{'readonly':[('product_type_selection','!=','drug')]}"/>
                                </group>
                                <group colspan="6" invisible="1">
                                    <field name="content"
                                           attrs="{'readonly':[('product_type_selection','!=','drug')]}"/>
                                </group>

                                <group colspan="6" invisible="1">
                                    <field name="quantity_text" string=""
                                           attrs="{'readonly':[('product_type_selection','!=','drug')]}"/>
                                </group>
                                <group colspan="6" invisible="1">
                                    <field name="calc_ext_use_drug"
                                           attrs="{'readonly':[('product_type_selection','!=','drug')]}"/>
                                </group>
                                <group colspan="6" invisible="1">
                                    <field name="instruction"
                                           attrs="{'readonly':[('product_type_selection','!=','drug')]}"/>
                                </group>
                                <group colspan="12" col="12">
                                    <field name="drug_dosage_ids">
                                        <tree editable="bottom">
                                            <field name="dosage"/>
                                            <field name="dosage_amount"/>
                                            <field name="create_date" />
                                            <field name="create_uid" options="{'no_open': True}"/>
                                        </tree>
                                    </field>
                                </group>
                            </group>
                        </page>
                        <page string="Tax">
                            <group colspan="12" col="12">
                                <field name="taxes_id" widget="many2many_tags"
                                       context="{'default_type_tax_use':'sale', 'search_default_sale': 1, 'search_default_service': type == 'service', 'search_default_goods': type == 'consu'}"/>
                                <span class="ms-2"/><field name="tax_string" nolabel="1"/>
                                <field name="supplier_taxes_id" widget="many2many_tags"
                                       context="{'default_type_tax_use':'purchase', 'search_default_purchase': 1, 'search_default_service': type == 'service', 'search_default_goods': type == 'consu'}"/>
                            </group>
                        </page>
                    </notebook>
                </group>
                <group colspan="12" col="12">
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>

                </group>
            </form>
        </field>
    </record>

    <record id="view_product_proxy_product_tree" model="ir.ui.view">
        <field name="name">product.proxy.product.tree</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <tree js_class="uic-list" delete="0">
                <field name="sequence" widget="handle"/>
                <field name="id"/>
                <field name="name" readonly="1"/>
                <field name="categ_id"/>
                <field name="list_price"/>
                <field name="priority_color"/>
            </tree>
        </field>
    </record>

    <record id="view_product_proxy_product_search" model="ir.ui.view">
        <field name="name">product.proxy.product.search</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="calculation_type"/>
                <field name="room_id"/>
                <field name="quantity_in_pack"/>
                <filter string="Is HIS" name="is_his" domain="[('categ_is_his', '=', 'True')]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <searchpanel>
                    <field name="product_type" string="Main Category"/>
                    <field name="categ_id" string="Sub Category" limit="500"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_product_proxy_product" model="ir.actions.act_window">
        <field name="name">Product Management</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{
            'search_default_filter_child': 1,
            'search_default_is_his': 1,
            'use_custom_search': '1',
            'open_filters_callback': 'custom_search_filter',
            'reset_filters_callback': 'custom_search_reset',
            'filter_is_active': False
        }</field>
        <field name="view_ids"
               eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('view_product_proxy_product_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_product_proxy_product_form')})]"/>
        <field name="search_view_id" ref="his.view_product_proxy_product_search"/>
    </record>

    <menuitem id="menu_product_proxy_templates" name="Products List"
              groups="his.group_his_admin,his.group_his_provisory,his.group_his_manager"
              parent="his.menu_product_management_main" action="action_product_proxy_product"
              sequence="1"/>

    <record model="ir.actions.server" id="action_export_pdf">
        <field name="name">Export Product List</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            action = records.action_export_pdf()
        </field>
    </record>

</odoo>
