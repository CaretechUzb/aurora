<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_product_type_form" model="ir.ui.view">
        <field name="name">his.product_type.form</field>
        <field name="model">his.category_base</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group name="share" string="Name &amp; Type">
                            <group col="12" colspan="12">
                                <group col="12" colspan="6">
                                    <field name="name"></field>
                                </group>
                                <!-- <group col="12" colspan="3">
                                    <field name="short_name"></field>
                                </group> -->
                                <group col="12" colspan="3">
                                    <field name="category_selection"></field>
                                </group>
                                <group col="12" colspan="3">
                                    <field name="sequence"></field>
                                </group>
                            </group>
                            <group name="WebSite" string="WebSite">
                                <group col="12" colspan="12">
                                    <group col="12" colspan="4">
                                        <field name="can_online_appointment"></field>
                                    </group>
                                    <group col="12" colspan="4">
                                        <field name="can_receive_call_back"></field>
                                    </group>
                                    <group col="12" colspan="4">
                                        <field name="sorting_to_website"></field>
                                    </group>
                                </group>
                            </group>
                            <group name="share" string="Doctor Share">
                                <group col="12" colspan="12">
                                    <group col="12" colspan="6">
                                        <field name="share_type"></field>
                                    </group>
                                    <group col="12" colspan="6">
                                        <field name="share_value"></field>
                                    </group>
                                </group>
                            </group>
                            <group name="bonus" string="Doctor Bonus">
                                <group col="12" colspan="12">
                                    <group col="12" colspan="6">
                                        <field name="recommendation_bonus_type"></field>
                                    </group>
                                    <group col="12" colspan="6">
                                        <field name="recommendation_bonus_value"></field>
                                    </group>
                                </group>
                            </group>
                            <group name="schedule" string="Schedule Options">
                                <group col="12" colspan="12">
                                    <group col="12" colspan="6">
                                        <field name="is_schedulable"></field>
                                    </group>
                                    <group col="12" colspan="6">
                                        <field name="schedule_type"></field>
                                    </group>
                                </group>
                            </group>
                            <group name="Favicon" string=" Product Type Favicon">
                                <group col="12" colspan="12">
                                    <group col="12" colspan="6">
                                        <field name="icon" widget="image" options="{'size': [250, 250]}"></field>
                                    </group>
                                    <group col="12" colspan="6">
                                        <field name="available_in_registration"></field>
                                    </group>
                                </group>
                            </group>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_product_type_tree" model="ir.ui.view">
        <field name="name">his.product_type.tree</field>
        <field name="model">his.category_base</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category_selection"/>
            </tree>
        </field>
    </record>

    <record id="view_product_type_search" model="ir.ui.view">
        <field name="name">his.product_type.search</field>
        <field name="model">his.category_base</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category_selection"/>
            </search>
        </field>
    </record>


    <record id="action_product_type" model="ir.actions.act_window">
        <field name="name">Product Type</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">his.category_base</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_child': 1}</field>
        <field name="search_view_id" ref="his.view_product_type_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
                                  (0, 0, {'view_mode': 'tree', 'view_id': ref('view_product_type_tree')}),
                                  (0, 0, {'view_mode': 'form', 'view_id': ref('view_product_type_form')})]"/>
    </record>

    <menuitem id="menu_product_type"
              name="Product Type"
              parent="his.menu_product_management_main"
              action="action_product_type"
              groups="his.group_his_admin,his.group_his_provisory,his.group_his_manager"
              sequence="3"/>
</odoo>
