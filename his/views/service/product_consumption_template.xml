<odoo>
    <record id="consumption_template_view_form" model="ir.ui.view">
        <field name="name">consumption_template.view.form</field>
        <field name="model">his.consumption_template</field>
        <field name="arch" type="xml">
            <form string="Consumption template">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="lines" >
                            <tree string="Lines" editable="bottom">
                                <field name="product_id" />
                                <field name="unit_quantity" />
                                <field name="product_uom_id" />
                                <field name="is_free" widget="boolean_toggle" />
                            </tree>
                        </field>
                    </group>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" />
                        <field name="message_ids" widget="mail_thread" />
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="consumption_template_view_tree" model="ir.ui.view">
        <field name="name">consumption_template.view.tree</field>
        <field name="model">his.consumption_template</field>
        <field name="arch" type="xml">
            <tree string="Consumption template">
                <field name="name" />
            </tree>
        </field>
    </record>
    <record id="consumption_template_action" model="ir.actions.act_window">
        <field name="name">Consumption template</field>
        <field name="res_model">his.consumption_template</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_his_consumption_template"
        name="Consumption templates"
        parent="his.menu_his_general_medical"
        action="consumption_template_action"
        sequence="2" />
</odoo>
