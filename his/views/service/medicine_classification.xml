<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_medicine_classification_form" model="ir.ui.view">
        <field name="name">his.medicine_classification.form</field>
        <field name="model">his.medicine_classification</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="abbreviation"/>
                        <field name="method"/>
                        <field name="times"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medicine_classification_tree" model="ir.ui.view">
        <field name="name">his.medicine_classification.tree</field>
        <field name="model">his.medicine_classification</field>
        <field name="arch" type="xml">
            <tree>
                <field name="abbreviation"/>
                <field name="method"/>
                <field name="times"/>
            </tree>
        </field>
    </record>

    <record id="view_medicine_classification_search" model="ir.ui.view">
        <field name="name">his.medicine_classification.search</field>
        <field name="model">his.medicine_classification</field>
        <field name="arch" type="xml">
            <search>
                <field name="abbreviation"/>
                <field name="method"/>
                <field name="times"/>
            </search>
        </field>
    </record>


    <record id="action_medicine_classification" model="ir.actions.act_window">
        <field name="name">Medicine Classification</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">his.medicine_classification</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_child': 1}</field>
        <field name="search_view_id" ref="his.view_medicine_classification_search"/>
    </record>

    <menuitem id="menu_medicine_classifications"
              name="Medicine Classification"
              parent="his.menu_other_configurations"
              action="action_medicine_classification"
              groups="his.group_his_admin,his.group_his_manager"
              sequence="6"/>
</odoo>