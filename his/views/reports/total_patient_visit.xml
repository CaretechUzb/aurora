<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_proxy_patient_visits_department_report_tree" model="ir.ui.view">
        <field name="name">his.proxy_patient_visits_department_report.tree</field>
        <field name="model">his.patient_visits_department_report</field>
        <field name="arch" type="xml">
            <tree js_class="list_handle_change" create="0">
                <field name="date"/>
                <field name="department_id"/>
                <field name="count"/>
            </tree>
        </field>
    </record>

    <record id="action_patient_visits_department_report" model="ir.actions.act_window">
        <field name="name">Total Patient Visit</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">his.patient_visits_department_report</field>
        <field name="view_mode">tree,pivot</field>
        <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('view_proxy_patient_visits_department_report_tree')})]"/>
        <field name="context">
            {
                'search_default_filter_child': 1,
                'use_custom_search': '1',
                'open_filters_callback': 'custom_search_filter',
                'reset_filters_callback': 'custom_search_reset',
                'filter_is_active': False
            }
         </field>
    </record>


    <menuitem id="menu_patient_visits_department_report"
              name="Total Patient Visit"
              parent="his.menu_report_management_main"
              action="action_patient_visits_department_report"
              sequence="1"/>

</odoo>