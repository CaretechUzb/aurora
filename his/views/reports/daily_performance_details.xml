<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_daily_performance_wizard_form" model="ir.ui.view">
        <field name="name">his.proxy.daily_performance_wizard.form</field>
        <field name="model">his.daily_performance_wizard</field>
        <field name="arch" type="xml">
            <form js_class="form_wo_cp">
                <group class="items-wrapper" colspan="12" col="12">
                        <group colspan="6">
                            <field name="company_id"
                                attrs="{'readonly': 1, 'no_open': True, 'no_create':1}">
                            </field>
                        </group>
                        <group colspan="6">
                            <field name="visit_date"
                                attrs="{'readonly':1}"></field>
                        </group>
                        <group colspan="6">
                            <field name="department_id"
                                attrs="{'readonly':1, 'no_open': True, 'no_create':1}">
                            </field>
                        </group>
                    <notebook>
                        <page name="Result Detail">
                            <field name="result_order_detail">
                                <tree>
                                    <field name="patient_name"/>
                                    <field name="gender"/>
                                    <field name="birth_date"/>
                                    <field name="service_code"/>
                                    <field name="service_name"/>
                                    <field name="total_amount"/>
                                    <field name="discount_amount"/>
                                    <field name="performance_amount"/>
                                    <field name="paid"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <footer></footer>
                </group>
                <footer></footer>
            </form>
        </field>
    </record>
</odoo>
