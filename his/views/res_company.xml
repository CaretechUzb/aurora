<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="his.view_res_company_form_inherit" model="ir.ui.view">
            <field name="name">his.view_res_company_form_inherit.form</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <group col="12" colspan="12">
                        <field name="company_full_name" string="Full name"/>
                    </group>
                    <group col="12" colspan="12">
                        <field name="company_legal_name" string="Legal name"/>
                    </group>
                    <group col="12" colspan="12">
                        <field name="director_id"/>
                    </group>
                    <group col="12" colspan="12">
                        <field name="medical_director"/>
                    </group>
                    <group col="12" colspan="12">
                        <field name="oked"/>
                    </group>
                </xpath>
                <xpath expr="//page[@name='general_info']" position="after">
                    <page string="Bank Accounts" name="bank_accounts">
                        <group>
                            <field name="bank_ids">
                                <tree editable="bottom">
                                    <field name="acc_number"/>
                                    <field name="bank_id"/>
                                    <field name="currency_id"/>
                                    <field name="is_main"/>
                                </tree>
                            </field>
                        </group>
                    </page>
                </xpath>
                <xpath expr="//page[@name='bank_accounts']" position="after">
                    <page string="Company location" name="company_location">
                        <group>
                            <field name="latitude"/>
                            <field name="longitude"/>
                            <!-- <field name="map_is"/> -->
                        </group>
                    </page>
                </xpath>
                <xpath expr="//field[@name='currency_id']" position="after">
                        <field name="start_time" widget="float-formate-time"/>
                        <field name="end_time" widget="float-formate-time"/>
                        <field name="working_days"
                                    widget="many2many_selection_checkbox"
                                    options="{'no_open': True, 'no_create': True}"/>
                        <field name="timezone"/>
                </xpath>
            </field>
        </record>
        <menuitem id="menu_his_res_company" name="Companies" parent="his.menu_company_configurations"
                  action="base.action_res_company_form" sequence="1"/>
    </data>
</odoo>
