<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ModelName_form_inherit" model="ir.ui.view">
            <field name="name">his.view_res_bank_form_inherit.form</field>
            <field name="model">res.bank</field>
            <field name="inherit_id" ref="base.view_res_bank_form"/>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='bic']" position="after">
                    <field name="mfo"/>
                </xpath>
            </field>
        </record>

        <record id="his_res_bank_tree_inherit" model="ir.ui.view">
            <field name="name">his_res_bank_tree_inherit.tree</field>
            <field name="model">res.bank</field>
            <field name="inherit_id" ref="base.view_res_bank_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="mfo"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>